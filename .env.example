# HAN environment template. Copy to `.env` (never commit `.env`) and replace every CHANGE_ME.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Core -------------------------------------------------------------------------------------------------
HAN_ENV=production                      # development | test | production (production refuses weak settings)
HAN_SECRET_KEY=CHANGE_ME                # 32+ random characters; signs session cookies and CSRF tokens
POSTGRES_PASSWORD=CHANGE_ME
HAN_COOKIE_SECURE=1                     # keep 1 behind HTTPS; set 0 only for plain-HTTP local testing
HAN_TRUST_PROXY=0                       # 1 only when a trusted reverse proxy sets X-Forwarded-For

# --- First administrators (created by the seed step; a missing password is generated and printed once) -------
HAN_BOOTSTRAP_TNI_ADMIN_EMAIL=
HAN_BOOTSTRAP_TECH_ADMIN_EMAIL=
HAN_BOOTSTRAP_TNI_ADMIN_PASSWORD=
HAN_BOOTSTRAP_TECH_ADMIN_PASSWORD=

# --- Translation providers (all optional; nothing is routable until an administrator enables a model) -------
# External processor: text leaves TNI infrastructure. Needs legal/security approval AND a project with
# "allow external processing" switched on.
HAN_GOOGLE_API_KEY=
# Local model runtime (the `inference` service). Confirm each model's licence before enabling it.
HAN_MADLAD_URL=                         # e.g. http://inference:9000
HAN_AFRINLLB_URL=
HAN_NLLB_URL=                           # research/evaluation only unless licensed; registry keeps it blocked by default
HAN_INFERENCE_TOKEN=                    # shared secret between backend and inference service
HAN_INFERENCE_MODEL_MADLAD=             # Hugging Face id or path, e.g. google/madlad400-3b-mt (verify licence first)
HAN_INFERENCE_MODEL_NLLB=
HAN_INFERENCE_MODEL_AFRINLLB=

# --- Development only ---------------------------------------------------------------------------------------
HAN_ENABLE_MOCK_PROVIDER=0              # 1 registers a labelled stub ("[MOCK DRAFT] ...") when HAN_ENV != production

# --- Optional tuning (defaults shown) -----------------------------------------------------------------------
# HAN_MAX_TEXT_CHARS=10000  HAN_RATE_LIMIT_AUTH_PER_MIN=10  HAN_RATE_LIMIT_TRANSLATE_PER_MIN=30
# HAN_PROVIDER_TIMEOUT_S=20  HAN_PROVIDER_RETRIES=1  HAN_TM_MIN_MATCH=70  HAN_SESSION_TTL_MINUTES=480
# HAN_JOBS_EAGER=0   (1 runs jobs inline without Redis/Celery: development only)
# HAN_CONTENT_LOGGING=0   (never enable in production without a data-protection review)

# --- Rhapsody publication uploads ----------------------------------------------------------------------
HAN_RHAPSODY_STORAGE_DIR=/var/lib/han/rhapsody  # persistent private volume; outside the web root
HAN_RHAPSODY_MAX_UPLOAD_BYTES=25000000
